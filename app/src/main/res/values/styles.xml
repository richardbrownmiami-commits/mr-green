<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#B98AFF</item>
        <item name="colorPrimaryVariant">#8154B3</item>
        <item name="colorSecondary">#B98AFF</item>
        <item name="colorOnPrimary">#0D0A14</item>
        <item name="colorSurface">#1C1529</item>
        <item name="android:colorAccent">#B98AFF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0D0A14</item>
        <item name="android:navigationBarColor">#0D0A14</item>
        <item name="android:statusBarColor">#0D0A14</item>
        <item name="android:textColorPrimary">#F6F0FF</item>
        <item name="android:textColorSecondary">#B8ABC9</item>
        <item name="materialButtonStyle">@style/Widget.MrGreen.Button</item>
    </style>
    <style name="Widget.MrGreen.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">#B98AFF</item>
        <item name="android:textColor">#160F22</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
